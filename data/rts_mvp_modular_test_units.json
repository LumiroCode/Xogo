  "units": {
    "height": "abstract height units",
    "footprint": "abstract ground-area units",
    "size": "derived = footprint * height",
    "speed": "tiles per second before terrain modifiers",
    "baseSignature": "0..100, higher = easier to detect",
    "sensorStrength": "0..100",
    "sensorRange": "tiles",
    "sensorResolution": "0..100",
    "durability": "HP",
    "armorFront": "flat damage reduction",
    "armorOther": "flat damage reduction",
    "weaponRange": "tiles",
    "damage": "damage per hit before armor",
    "accuracy": "0..1",
    "suppressionPower": "suppression per hit/event, relative scale",
    "rateOfFire": "shots per second",
    "supplyCapacity": "generic supply units carried",
    "supplyState": "current generic supply units carried"
  },
  "rules": {
    "size_formula": "footprint * height",
    "weight_model_mvp": "weight == size",
    "damage_formula": "max(0, damage - relevant_armor)",
    "supply_per_shot": 1,
    "emission": "runtime ON/OFF flag; defaults to false",
    "penetration": "not in MVP",
    "coverUsage": "not a unit stat; effective cover depends on terrain cover and unit size",
    "fuel": "not in MVP",
    "cohesion": "not in MVP",
    "assembly": "platform + weapon + specialization"
